APP_URL=http://localhost:8000
SECRET_KEY=change-me-in-prod

DATABASE_URL=sqlite:///./form_deploy.db
# vi du MySQL: DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/form_deploy

# Cac bien danh dau (*) o duoi day chi duoc doc DUY NHAT 1 LAN de seed dong dau tien
# cua bang app_setting/catalog_setting khi DB con trong (lan dau chay hoac DB moi).
# Sau do gia tri that su nam trong DB va sua truc tiep qua UI Setting > General (hoac
# /catalog voi rieng CATALOG_CHARTS_DIR/CATALOG_EXCLUDED_DIRS) - sua o day KHONG con
# tac dung voi 1 DB da co du lieu.

# Auth
AUTH_DEV_MODE=true
AUTH_ENABLE_PASSWORD=false
SESSION_REMEMBER_HOURS=168  # (*) - so gio, sua o Setting > General > Dang nhap
# SESSION_REMEMBER_MIN_HOURS/MAX_HOURS: nguong chan min/max cho o "so gio ghi nho dang
# nhap" o Settings > General - chi doc tu .env (khong dua len UI, khong luu app_setting),
# doi gia tri can restart app. MAX cung la tran cung Max-Age cua cookie session (server
# khong bao gio chap nhan cookie song lau hon MAX du gia tri dang luu trong DB la bao nhieu).
SESSION_REMEMBER_MIN_HOURS=24
SESSION_REMEMBER_MAX_HOURS=168
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# Git repo Helm charts
# GIT_REMOTE_CREDENTIALS: chi phan authen dang "user:token" (vd form-dev:xxx), duoc
# ghep vao ngay sau scheme cua Repo URL luc dung (xem git_service._build_authenticated_url).
# Repo URL (khong kem credential, vd https://gitlab.g-pay.vn/devops/helm/applications.git)
# sua o Setting > General - BAT BUOC vao webui cau hinh 1 lan sau khi nang cap, DB seed
# rong vi khong the tach tu dong tu GIT_REMOTE_APPLICATIONS_URL (bien cu, da bo).
GIT_REMOTE_CREDENTIALS=
GIT_DIRECTORY_APPLICATIONS_STAGING=./data/repo-staging
GIT_DIRECTORY_APPLICATIONS_MASTER=./data/repo-master
GIT_BRANCH_STAGING=staging
GIT_BRANCH_MASTER=master
GIT_COMMIT_AUTHOR_EMAIL=form-deploy@g-pay.vn  # (*)
GIT_COMMIT_AUTHOR_NAME=form-deploy@g-pay.vn   # (*)
CATALOG_CHARTS_DIR=charts                                                        # (*)
CATALOG_EXCLUDED_DIRS=redis,rabbitmq,kafka,mqtt-proxy,standard,ambassador,temporal # (*)
CHART_VALUES_FILE_TEMPLATE=charts/{project}/{application}/values-production.yaml # (*)
ROLLBACK_ALLOWED_SECONDS=259200                                                   # (*)
# Duong dan file YAML dung chung nhieu app (cau truc {project}: {application}: replicas:
# "N") cho tinh nang Bat/Tat staging (nhanh staging) va thay doi replicas Production
# (nhanh master) - sua duoc o Setting > General sau khi seed lan dau.
STAGING_VALUES_FILE_PATH=envValues/values-staging.yaml        # (*)
PRODUCTION_VALUES_FILE_PATH=envValues/values-production.yaml  # (*)
# BAT: thay doi Production tao Merge Request (GitLab push option) thay vi push thang - (*)
PRODUCTION_USE_MERGE_REQUEST=false
# Xac thuc GitLab push webhook (POST /webhook/git, header X-Gitlab-Token) - trigger sync
# catalog/staging/production ngay khi co push thay vi doi job dinh ky. Rong = tu choi moi
# request (fail-closed), webhook coi nhu chua bat.
GIT_WEBHOOK_SECRET=

# ArgoCD (chi doc)
ARGOCD_URL_API=
ARGOCD_URL_APPLICATION=      # (*)
ARGOCD_TOKEN=
ARGOCD_APPLICATION_POSTFIX=  # (*) dung cho tinh nang theo doi Running/DeployTask
ARGOCD_APPLICATION_POSTFIX_STAGING=     # (*) dung cho nut Restart o /staging, vd -dev
ARGOCD_APPLICATION_POSTFIX_PRODUCTION=  # (*) dung cho nut Restart o /production, vd -sandbox
RESTART_COOLDOWN_SECONDS=60             # (*) rate limit giua 2 lan Restart cung 1 app (giay)

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_SYSTEM=  # (*)
TELEGRAM_WEBHOOK_SECRET=
# Thong bao Bat/Tat staging + thay doi replicas Production dung CHUNG bot voi
# TELEGRAM_BOT_TOKEN o tren (luong deploy), chi khac chat id/channel - sua duoc o
# Setting > General, kem cong tac bat/tat rieng tung kenh.
TELEGRAM_CHAT_ID_STAGING=  # (*)
TELEGRAM_CHAT_ID_PRODUCTION=  # (*)

# Mail
ENABLE_MAIL=true  # (*)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=form-deploy@g-pay.vn                        # (*)
MAIL_TO=                                               # (*)
MAIL_SUBJECT=[form-deploy] Deploy notification         # (*)

# Scheduler
ENABLE_SCHEDULER=true  # (*)
ENABLE_30MIN_REMINDER=false  # (*)
RUNNING_ALERT_AFTER_MINUTES=15  # (*)

CATALOG_AUTO_SYNC_INTERVAL_MINUTES=15